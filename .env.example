# Copy to .env and fill in. Generate secrets with:
#   openssl rand -hex 32            (API secret, JWT secret)
#   openssl rand -hex 16            (database passwords)
#   python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'  (Fernet key)
AIRFLOW_UID=1000
AIRFLOW_IMAGE=apache/airflow:3.3.1
POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
FHIR_DB_PASSWORD=
